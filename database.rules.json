{
  "rules": {
    "foodtruck": {
      ".read": "auth != null",

      "menu": {
        ".write": "auth != null"
      },

      "meta": {
        ".write": "auth != null"
      },

      "pickupCounter": {
        ".write": "root.child('foodtruck/meta/presence/online').val() === true && root.child('foodtruck/meta/presence/ordersOpen').val() === true"
      },

      "orders": {
        ".indexOn": ["pickup", "status", "createdAt"],

        "$orderId": {
          ".write": "(!data.exists() && root.child('foodtruck/meta/presence/online').val() === true && root.child('foodtruck/meta/presence/ordersOpen').val() === true && newData.hasChildren(['pickup','items','total','status','createdAt']) && newData.child('total').isNumber() && newData.child('total').val() <= 500000 && newData.child('total').val() >= 0) || (data.exists())"
        }
      }
    }
  }
}
